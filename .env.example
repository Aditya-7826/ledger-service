# Copy this file to .env and change the password. Never commit .env.

# --- PostgreSQL (the single source of truth) ---
POSTGRES_USER=ledger
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ledger
# Host port. 5434 avoids clashing with a Postgres already installed on 5432.
POSTGRES_PORT=5434
DATABASE_URL=postgres://ledger:change-me@localhost:5434/ledger?sslmode=disable
# Must stay below Postgres max_connections (100) across all services.
DB_MAX_CONNS=20

# --- Redpanda (Kafka API) ---
KAFKA_BROKERS=localhost:19092

# --- API ---
API_PORT=8080
LOG_LEVEL=info
# Largest single transfer, in minor units (paise). 100000000000 = Rs 1,000,000,000.00
MAX_TRANSFER_MINOR=100000000000
IDEMPOTENCY_TTL_HOURS=24

# --- Dashboard ---
# The dashboard is served on http://localhost:8088
WEB_PORT=8088
